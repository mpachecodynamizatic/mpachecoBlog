{
  "name": "blog-tech-bc-pbi",
  "version": "1.0.0",
  "description": "Tech blog for Business Central and Power BI",
  "main": "index.js",
  "scripts": {
    "build": "eleventy && tailwindcss -i src/styles/main.css -o _site/css/main.css --minify",
    "dev": "eleventy && npm-run-all --parallel dev:css dev:11ty",
    "dev:css": "tailwindcss -i src/styles/main.css -o _site/css/main.css --watch",
    "dev:11ty": "eleventy --serve --incremental",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\""
  },
  "keywords": [
    "blog",
    "11ty",
    "business-central",
    "power-bi"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.1",
    "gray-matter": "^4.0.3",
    "lunr": "^2.3.9",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-highlightjs": "^4.0.1",
    "markdown-it-table-of-contents": "^0.6.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.31",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "luxon": "^3.7.2"
  }
}
